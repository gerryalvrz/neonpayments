# Server-only Postgres. Use the Supabase Transaction pooler (port 6543) on Vercel.
# Never NEXT_PUBLIC_. Percent-encode special characters in the password.
DATABASE_URL=

# Optional Textile FX partner key. Default RFQ is anonymous (same as the public Swap).
# Only send the key if Textile has rfqV2Allowed AND this is a tx_live_… key.
# A tx_test_… key cannot hit Celo 42220.
TEXTILE_API_KEY=
TEXTILE_RFQ_USE_API_KEY=false
